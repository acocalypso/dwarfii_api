{
  "name": "dwarfii_api",
  "version": "3.0.0",
  "description": "wrapper for Dwarf II telescope API",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src index.js",
    "format": "prettier --check \"src/**/*.{ts,js}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,js}\"",
    "CI": "npm run lint && npm run format && npm run typecheck",
    "generate-docs": "jsdoc -c jsdoc.json  -R README.md",
    "ts": "tsc -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json",
    "test": "node src/__tests__/v3_camera_params.test.js && node src/__tests__/tele_mosaic.test.js",
    "compile-proto": "pbjs -t static-module -w ./wrapper/wrapper.js --dependency protobufjs/minimal.js -o ./src/protobuf/protobuf.js ./src/proto/*.proto && prettier --write \"./src/protobuf/protobuf.js\"",
    "compile-protoJS": "pbjs -t static-module -w ./wrapper/wrapper.js --dependency ./minimal.js -o ./dist_js/src/protobuf/protobuf.js ./src/proto/*.proto && prettier --write \"./dist_js/src/protobuf/protobuf.js\"",
    "generate-types": "pbts -o dist/src/protobuf/protobuf.d.ts ./src/protobuf/protobuf.js",
    "copy-files": "copyfiles -u 1 src/proto/*.proto dist/src/",
    "build": "npm run compile-proto && npm run compile-protoJS && npm run CI && npm run ts && npm run generate-types && npm run copy-files && npm run generate-docs"
  },
  "type": "module",
  "author": "wykhuh & stevejcl",
  "repository": {
    "type": "git",
    "url": "https://github.com/DwarfTelescopeUsers/dwarfii_api"
  },
  "license": "ISC",
  "dependencies": {
    "protobufjs": "^7.6.6"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "docdash": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.9.6",
    "protobufjs-cli": "^1.3.3",
    "typescript": "^5.9.3"
  }
}
